{
    "version": 1,
    "disable_existing_loggers": false,
    "formatters": {
        "simple": {
            "format": "%(asctime)s - %(process)d - %(name)s - %(levelname)s: %(message)s"
        }
    },
    "handlers": {
        "console": {
            "class": "logging.StreamHandler",
            "level": "INFO",
            "formatter": "simple",
            "stream": "ext://sys.stdout"
        }
    },
    "loggers": {
        "elisa.observer": {
            "level": "WARNING",
            "handlers": [],
            "propagate": true
        },
        "elisa.binary_system": {
            "level": "WARNING",
            "handlers": [],
            "propagate": true
        },
        "elisa.atm": {
            "level": "WARNING",
            "handlers": [],
            "propagate": true
        },
        "elisa.ld": {
            "level": "WARNING",
            "handlers": [],
            "propagate": true
        },
        "scipy": {
            "level": "WARNING",
            "handlers": [],
            "propagate": true
        }
    },
    "root": {
        "level": "DEBUG",
        "handlers": [
            "console"
        ]
    }
}
